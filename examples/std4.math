# Micromagnetic Standard Problem 4 in mathlang — reversal of a 500 x 125 x 3 nm
# permalloy film, reproducing the muMAG / mumax3 reference.
#
# Reference: relaxed  m.avg = ( 0.9670,  0.1253, 0)
#            t = 1 ns  m.avg = (-0.9846,  0.1260, 0.0433)
#
# Uses the high-level `world` API from libraries/mag.math — the world is an
# explicit record (not hidden global state). Runs in a few minutes on CPU.
# View the result live with:  !animateField final
!include mag

# geometry + material bundled into a world record. `alpha` defaults to 0.02;
# a sweep would vary it in place with mag.reverse((..w, alpha = 0.05), …).
w = mag.world(nx = 128, ny = 32,
              cell = (500e-9/128, 125e-9/32, 3e-9),
              Msat = 800e3, Aex = 13e-12)

# relax an almost-uniform state to the S-state
m0      = vec.normalize(mag.bcast([1, 0.1, 0], w.nx, w.ny))
relaxed = mag.relax(w, m0)
!print relaxed  m.avg = {round(mean(relaxed[.., .., 0]),4)}, {round(mean(relaxed[.., .., 1]),4)}  (ref 0.9670, 0.1253)

# apply the reversal field and evolve 1 ns (adaptive RK45)
final = mag.reverse(w, relaxed, [-24.6e-3, 4.3e-3, 0], 1e-9)
!print final 1ns m.avg = {round(mean(final[.., .., 0]),4)}, {round(mean(final[.., .., 1]),4)}, {round(mean(final[.., .., 2]),4)}  (ref -0.9846, 0.1260, 0.0433)
