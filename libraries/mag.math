# Micromagnetics — Landau–Lifshitz–Gilbert dynamics on a tensor magnetization field.
#
# The magnetization m is a unit-vector field stored as a plain tensor:
#   [nx, ny, 3]  for a 2-D sample   (or a single [3] vector for a macrospin).
# Effective fields are in Tesla. Constants follow mumax3's conventions, so results
# can be validated against mumax outputs (loaded with !loadovf).
#
# Usage:
#   !include examples/mag.math
#   heff = m -> mag.exchangeField(m, Aex, Msat, dx) + Bext   # effective field
#   mf   = mag.run(m0, heff, alpha, dt, nsteps)              # evolve
!namespace mag

# --- physical constants (SI) ---
gamma0 = 1.7595e11          # gyromagnetic ratio, rad/(T s)  (mumax GammaLL)
mu0    = 4e-7 * pi          # vacuum permeability, T m/A

# --- LLG torque: dm/dt for magnetization m in effective field B (Tesla) ---
#   dm/dt = -gamma0/(1+a^2) [ m×B + a m×(m×B) ]
llg(m, B, a) = -gamma0/(1 + a^2) * (vec.cross(m, B) + a*vec.cross(m, vec.cross(m, B)))

# --- exchange field (Tesla): (2 Aex/Msat) ∇²m ---
# Matches mumax's convention (B_exch in Tesla, no mu0). Componentwise spatial
# Laplacian (shift leaves the trailing component axis untouched); edge-replicating
# (Neumann) boundaries via shift.
private lap(m, dx) = (shift(m,1,0) + shift(m,-1,0) + shift(m,1,1) + shift(m,-1,1) - 4*m) / dx^2
exchangeField(m, Aex, Msat, dx) = (2*Aex/Msat) * lap(m, dx)

# --- broadcast a constant 3-vector B to a uniform [nx,ny,3] field ---
# (mathlang has no trailing-axis broadcast, so a uniform field, e.g. a Zeeman
#  field B_ext, is built explicitly.)
bcast(B, nx, ny) = tensor((i, j, c) -> B[c], nx, ny, 3)

# --- demag operator (Tesla): mu0*Msat*(N ⊛ m) via FFT convolution ---
# The demagnetizing (magnetostatic) field. Because the demag tensor N is
# geometry-only, demagOp precomputes the kernel FFTs ONCE and returns a closure
# m -> B_demag for reuse across time steps (essential — recomputing the kernel
# each step is ruinously slow). m is [nx,ny,3] (2-D); dx,dy the in-plane cell size,
# dz the film thickness. Matches mumax to ~1e-7. (Kernel stored (y,x); m is
# transposed in and the result back out.)
demagOp(nx, ny, Msat, dx, dy, dz) = {
    K   = demagkernel(nx, ny, 1, dx, dy, dz);
    Kxx = fft(K[0,0,..,..]); Kxy = fft(K[1,0,..,..]);
    Kyy = fft(K[3,0,..,..]); Kzz = fft(K[5,0,..,..]);
    scl = mu0 * Msat;
    m -> {
        pad(t) = tensor((i,j) -> if((i<ny) & (j<nx), t[i,j], 0.0), 2*ny, 2*nx);
        mxh = fft(pad(transpose(m[.., .., 0])));
        myh = fft(pad(transpose(m[.., .., 1])));
        mzh = fft(pad(transpose(m[.., .., 2])));
        Bx = re(ifft(Kxx*mxh + Kxy*myh));
        By = re(ifft(Kxy*mxh + Kyy*myh));
        Bz = re(ifft(Kzz*mzh));
        crop(b) = tensor((x,y) -> b[y,x], nx, ny);   # crop [0:ny,0:nx] and (y,x)->(x,y)
        scl * cat(2, unsqueeze(crop(Bx),2), unsqueeze(crop(By),2), unsqueeze(crop(Bz),2))
    }
}

# one-shot demag field (rebuilds the kernel each call — use demagOp for stepping)
demagField(m, Msat, dx, dy, dz) = demagOp(shape(m)[0], shape(m)[1], Msat, dx, dy, dz)(m)

# --- one RK4 step of dm/dt = llg(m, heff(m), a), renormalized to |m|=1 ---
#   heff : m -> effective field B (Tesla), a function of the current m.
step(m, heff, a, dt) = {
    k1 = llg(m, heff(m), a);
    m2 = m + dt/2*k1; k2 = llg(m2, heff(m2), a);
    m3 = m + dt/2*k2; k3 = llg(m3, heff(m3), a);
    m4 = m + dt*k3;   k4 = llg(m4, heff(m4), a);
    vec.normalize(m + dt/6 * (k1 + 2*k2 + 2*k3 + k4))
}

# --- run n RK4 steps, returning the final magnetization ---
run(m0, heff, a, dt, n) = iterate(m -> step(m, heff, a, dt), m0, n)

# --- relaxation to an energy minimum (no precession) ---
# Damping-only descent using the torque m×(m×H) (alpha-independent, like mumax's
# relax()): dm ∝ H - m(m·H) rotates m toward the effective field, lowering energy.
# `rate` is a pseudo-time step (tune for stability); n is the number of steps.
private dampTorque(m, B) = vec.cross(m, vec.cross(m, B))
relaxStep(m, heff, rate) = vec.normalize(m - rate * dampTorque(m, heff(m)))
relax(m0, heff, rate, n) = iterate(m -> relaxStep(m, heff, rate), m0, n)
