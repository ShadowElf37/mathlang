# Micromagnetics — Landau–Lifshitz–Gilbert dynamics on a tensor magnetization field.
#
# The magnetization m is a unit-vector field stored as a plain tensor [nx,ny,3]
# (2-D), or a single [3] vector for a macrospin. Effective fields are in Tesla;
# constants follow mumax3, so results validate against mumax outputs (!loadovf).
#
# Two levels of API:
#   * High-level, bundling geometry+material into a `world` record (like a mumax
#     script, but the world is an explicit value, not hidden global state):
#         w = mag.world((nx=128, ny=32, cell=(3.9e-9,3.9e-9,3e-9),
#                        Msat=800e3, Aex=13e-12, alpha=0.02))
#         relaxed = mag.relax(w, m0)                    # damped LLG to equilibrium
#         final   = mag.reverse(w, relaxed, Bext, 1e-9) # adaptive RK45 to t_end
#   * Low-level building blocks (exchangeField, demagField, llg, step, run,
#     adaptive) for full control.
!namespace mag

# --- physical constants (SI) ---
gamma0 = 1.7595e11          # gyromagnetic ratio, rad/(T s)  (mumax GammaLL)
mu0    = 4e-7 * pi          # vacuum permeability, T m/A

# --- LLG torque: dm/dt for magnetization m in effective field B (Tesla) ---
#   dm/dt = -gamma0/(1+a^2) [ m×B + a m×(m×B) ]
!helpdef mag.llg LLG torque dm/dt for magnetization m in effective field B (Tesla), damping a: -gamma0/(1+a^2)[ m×B + a m×(m×B) ]. m,B are [3] or [nx,ny,3].
llg(m, B, a) = -gamma0/(1 + a^2) * (vec.cross(m, B) + a*vec.cross(m, vec.cross(m, B)))

# --- exchange field (Tesla): (2 Aex/Msat) ∇²m ---
# mumax convention (no mu0). Componentwise, per-axis (dx,dy) Laplacian; shift leaves
# the trailing component axis untouched and gives edge-replicating (Neumann) BCs.
private lap(m, dx, dy) = (shift(m,1,0) + shift(m,-1,0) - 2*m)/dx^2 + (shift(m,1,1) + shift(m,-1,1) - 2*m)/dy^2
!helpdef mag.exchangeField exchange field (Tesla) = (2 Aex/Msat) grad^2 m. Args (m, Aex, Msat, dx, dy); Neumann boundaries. m is [nx,ny,3].
exchangeField(m, Aex, Msat, dx, dy) = (2*Aex/Msat) * lap(m, dx, dy)

# --- broadcast a constant 3-vector B to a uniform [nx,ny,3] field ---
!helpdef mag.bcast broadcast a constant 3-vector B to a uniform [nx,ny,3] field (e.g. a Zeeman field B_ext). mathlang has no trailing-axis broadcast, so uniform fields are built explicitly.
bcast(B, nx, ny) = tensor((i, j, c) -> B[c], nx, ny, 3)

# --- multiply a scalar field s [nx,ny] by a vector field v [nx,ny,3] (per cell) ---
!helpdef mag.scaleVec multiply a scalar field s [nx,ny] by a vector field v [nx,ny,3] componentwise (per cell). Fills the trailing-axis-broadcast gap.
scaleVec(s, v) = tensor((i, j, c) -> s[i,j] * v[i,j,c], shape(v)[0], shape(v)[1], 3)

# --- uniaxial anisotropy field (Tesla) ---
# B = (2 Ku1 (m·u) + 4 Ku2 (m·u)^3) u / Msat, u = normalized easy axis.
!helpdef mag.anisField uniaxial anisotropy field (Tesla): (2 Ku1 (m.u) + 4 Ku2 (m.u)^3) u / Msat. Args (m, Ku1, Ku2, u, Msat); u is the [3] easy axis (normalized internally).
anisField(m, Ku1, Ku2, u, Msat) = {
    nx = shape(m)[0]; ny = shape(m)[1];
    uf = bcast(vec.normalize(u), nx, ny);
    mu = vec.vdot(m, uf);                       # (m·u) per cell, [nx,ny]
    scaleVec((2*Ku1*mu + 4*Ku2*mu^3) / Msat, uf)
}

# --- magnetoelastic field (Tesla) from strain tensor (exx..ezz) ---
# Bx = -2/Msat [B1 mx exx + B2(my exy + mz exz)], and cyclic (Gurevich&Melkov 12.18).
!helpdef mag.melField magnetoelastic field (Tesla) from a uniform strain tensor. Args (m, B1, B2, strain, Msat) where strain=(exx,eyy,ezz,exy,exz,eyz). Bx=-2/Msat[B1 mx exx + B2(my exy + mz exz)], cyclic.
melField(m, B1, B2, strain, Msat) = {
    nx = shape(m)[0]; ny = shape(m)[1];
    exx = strain[0]; eyy = strain[1]; ezz = strain[2];
    exy = strain[3]; exz = strain[4]; eyz = strain[5];
    mx = m[.., .., 0]; my = m[.., .., 1]; mz = m[.., .., 2];
    bx = -2/Msat * (B1*mx*exx + B2*(my*exy + mz*exz));
    by = -2/Msat * (B1*my*eyy + B2*(mx*exy + mz*eyz));
    bz = -2/Msat * (B1*mz*ezz + B2*(mx*exz + my*eyz));
    cat(2, unsqueeze(bx,2), unsqueeze(by,2), unsqueeze(bz,2))
}

# --- demag field (Tesla): mu0*Msat*(N ⊛ m), via the compiled `demagfield` builtin ---
# FFT convolution of the demag tensor with m; the geometry-only kernel FFTs are
# cached, so it is cheap to call every step. Matches mumax to ~1e-7.
!helpdef mag.demagField demagnetizing field (Tesla) mu0*Msat*(N conv m), via the compiled FFT convolution. Args (m, Msat, dx, dy, dz); m is [nx,ny,3], dz the film thickness. Matches mumax ~1e-7.
demagField(m, Msat, dx, dy, dz) = demagfield(m, Msat, dx, dy, dz)

!helpdef mag.demagOp returns a closure m -> B_demag for fixed geometry (the demag kernel is cached by the builtin). Args (nx, ny, Msat, dx, dy, dz).
demagOp(nx, ny, Msat, dx, dy, dz) = m -> demagfield(m, Msat, dx, dy, dz)

# --- one RK4 step of dm/dt = llg(m, heff(m), a), renormalized to |m|=1 ---
#   heff : m -> effective field B (Tesla), a function of the current m.
!helpdef mag.step one RK4 step of dm/dt = llg(m, heff(m), a), renormalized to unit length. Args (m, heff, a, dt); heff is a function m -> B (Tesla).
step(m, heff, a, dt) = {
    k1 = llg(m, heff(m), a);
    m2 = m + dt/2*k1; k2 = llg(m2, heff(m2), a);
    m3 = m + dt/2*k2; k3 = llg(m3, heff(m3), a);
    m4 = m + dt*k3;   k4 = llg(m4, heff(m4), a);
    vec.normalize(m + dt/6 * (k1 + 2*k2 + 2*k3 + k4))
}

# --- run n fixed-step RK4 steps, returning the final magnetization ---
!helpdef mag.run run n fixed-step RK4 steps of the LLG equation. Args (m0, heff, a, dt, n); heff is a function m -> B (Tesla). Returns the final magnetization.
run(m0, heff, a, dt, n) = iterate(m -> step(m, heff, a, dt), m0, n)

# --- adaptive Dormand-Prince RK45 (mumax's default solver) ---
# One DP45 step from m over time h; returns (5th-order solution, embedded error).
private dp45(m, heff, a, h) = {
    k1 = llg(m, heff(m), a);
    z2 = m + h*(1/5*k1);                                            q2 = llg(z2, heff(z2), a);
    z3 = m + h*(3/40*k1 + 9/40*q2);                                 q3 = llg(z3, heff(z3), a);
    z4 = m + h*(44/45*k1 - 56/15*q2 + 32/9*q3);                     q4 = llg(z4, heff(z4), a);
    z5 = m + h*(19372/6561*k1 - 25360/2187*q2 + 64448/6561*q3 - 212/729*q4);   q5 = llg(z5, heff(z5), a);
    z6 = m + h*(9017/3168*k1 - 355/33*q2 + 46732/5247*q3 + 49/176*q4 - 5103/18656*q5); q6 = llg(z6, heff(z6), a);
    y5 = m + h*(35/384*k1 + 500/1113*q3 + 125/192*q4 - 2187/6784*q5 + 11/84*q6);
    q7 = llg(y5, heff(y5), a);
    y4 = m + h*(5179/57600*k1 + 7571/16695*q3 + 393/640*q4 - 92097/339200*q5 + 187/2100*q6 + 1/40*q7);
    (y5, max(abs(y5 - y4)))
}
# One adaptive step of (m, t, dt): step to at most t_end; accept if the error is
# within tol (then grow dt), else reject and retry smaller.
private adaptiveStep(s, heff, a, t_end, tol) = {
    m = s[0]; t = s[1]; dt = s[2];
    if(t >= t_end, s, {
        h   = min(dt, t_end - t);
        res = dp45(m, heff, a, h);
        err = res[1] / tol;
        fac = 0.9 * (1 / max(err, 1e-12))^0.2;
        if(err <= 1,
           (vec.normalize(res[0]), t + h, dt * vec.clamp(fac, 0.2, 5)),
           (m, t, dt * vec.clamp(fac, 0.2, 0.9)))
    })
}
!helpdef mag.adaptive adaptive Dormand-Prince RK45 (mumax's default). Integrate m0 to t_end with error-per-step tol (like mumax MaxErr). Args (m0, heff, a, dt0, t_end, tol, maxsteps).
adaptive(m0, heff, a, dt0, t_end, tol, maxsteps) =
    iterate(s -> adaptiveStep(s, heff, a, t_end, tol), (m0, 0.0, dt0), maxsteps)[0]

# ── High-level `world` API ──────────────────────────────────────────────────────

# --- world: bundle geometry + material into an explicit record ---
# cfg is a record with fields: nx, ny, cell=(dx,dy,dz), Msat, Aex, alpha.
!helpdef mag.world bundle geometry+material into a world record. Pass a record cfg=(nx=, ny=, cell=(dx,dy,dz), Msat=, Aex=, alpha=); returns a world with dx,dy,dz unpacked, read by relax/reverse/effField.
world(cfg) = (nx = cfg.nx, ny = cfg.ny,
              dx = cfg.cell[0], dy = cfg.cell[1], dz = cfg.cell[2],
              Msat = cfg.Msat, Aex = cfg.Aex, alpha = cfg.alpha)

# --- effective field (Tesla) for a world: exchange + demag + applied field Bext ---
!helpdef mag.effField effective field (Tesla) for a world w: exchange + demag + the applied field Bext ([nx,ny,3]). Args (w, m, Bext).
effField(w, m, Bext) = exchangeField(m, w.Aex, w.Msat, w.dx, w.dy)
                     + demagfield(m, w.Msat, w.dx, w.dy, w.dz)
                     + Bext

private zero(w) = bcast([0, 0, 0], w.nx, w.ny)
private evolveTo(w, m0, Bext, a, t_end) =
    adaptive(m0, m -> effField(w, m, Bext), a, 1e-13, t_end, 1e-5, 200000)

# --- relax to equilibrium (strongly-damped LLG, no applied field) ---
!helpdef mag.relax relax a world's magnetization to equilibrium via strongly-damped LLG (adaptive RK45, alpha=1, no applied field). Args (w, m0). Returns the relaxed magnetization.
relax(w, m0) = evolveTo(w, m0, zero(w), 1.0, 2e-9)

# --- reverse / drive: evolve under an applied field to t_end (world's damping) ---
!helpdef mag.reverse evolve a world's magnetization under a uniform applied field Bext ([3]) to time t_end, using the world's own damping (adaptive RK45). Args (w, m0, Bext, t_end).
reverse(w, m0, Bext, t_end) = evolveTo(w, m0, bcast(Bext, w.nx, w.ny), w.alpha, t_end)
