# Micromagnetics — Landau–Lifshitz–Gilbert dynamics on a tensor magnetization field.
#
# The magnetization m is a unit-vector field stored as a plain tensor:
#   [nx, ny, 3]  for a 2-D sample   (or a single [3] vector for a macrospin).
# Effective fields are in Tesla. Constants follow mumax3's conventions, so results
# can be validated against mumax outputs (loaded with !loadovf).
#
# Usage:
#   !include examples/mag.math
#   heff = m -> mag.exchangeField(m, Aex, Msat, dx) + Bext   # effective field
#   mf   = mag.run(m0, heff, alpha, dt, nsteps)              # evolve
!namespace mag

# --- physical constants (SI) ---
gamma0 = 1.7595e11          # gyromagnetic ratio, rad/(T s)  (mumax GammaLL)
mu0    = 4e-7 * pi          # vacuum permeability, T m/A

# --- LLG torque: dm/dt for magnetization m in effective field B (Tesla) ---
#   dm/dt = -gamma0/(1+a^2) [ m×B + a m×(m×B) ]
llg(m, B, a) = -gamma0/(1 + a^2) * (vec.cross(m, B) + a*vec.cross(m, vec.cross(m, B)))

# --- exchange field (Tesla): (2 Aex/Msat) ∇²m ---
# Matches mumax's convention (B_exch in Tesla, no mu0). Componentwise spatial
# Laplacian (shift leaves the trailing component axis untouched); edge-replicating
# (Neumann) boundaries via shift.
private lap(m, dx) = (shift(m,1,0) + shift(m,-1,0) + shift(m,1,1) + shift(m,-1,1) - 4*m) / dx^2
exchangeField(m, Aex, Msat, dx) = (2*Aex/Msat) * lap(m, dx)

# --- broadcast a constant 3-vector B to a uniform [nx,ny,3] field ---
# (mathlang has no trailing-axis broadcast, so a uniform field, e.g. a Zeeman
#  field B_ext, is built explicitly.)
bcast(B, nx, ny) = tensor((i, j, c) -> B[c], nx, ny, 3)

# --- demag field (Tesla): mu0*Msat*(N ⊛ m) ---
# The demagnetizing (magnetostatic) field, via the compiled `demagfield` builtin
# (FFT convolution of the demag tensor with m; the geometry-only kernel FFTs are
# cached, so calling it every time step is cheap). m is [nx,ny,3] (2-D); dx,dy the
# in-plane cell size, dz the film thickness. Matches mumax to ~1e-7.
demagField(m, Msat, dx, dy, dz) = demagfield(m, Msat, dx, dy, dz)

# demag operator: a closure m -> B_demag for a fixed geometry (nx,ny carried for
# API symmetry; the builtin caches the kernel internally).
demagOp(nx, ny, Msat, dx, dy, dz) = m -> demagfield(m, Msat, dx, dy, dz)

# --- one RK4 step of dm/dt = llg(m, heff(m), a), renormalized to |m|=1 ---
#   heff : m -> effective field B (Tesla), a function of the current m.
step(m, heff, a, dt) = {
    k1 = llg(m, heff(m), a);
    m2 = m + dt/2*k1; k2 = llg(m2, heff(m2), a);
    m3 = m + dt/2*k2; k3 = llg(m3, heff(m3), a);
    m4 = m + dt*k3;   k4 = llg(m4, heff(m4), a);
    vec.normalize(m + dt/6 * (k1 + 2*k2 + 2*k3 + k4))
}

# --- run n fixed-step RK4 steps, returning the final magnetization ---
run(m0, heff, a, dt, n) = iterate(m -> step(m, heff, a, dt), m0, n)

# --- relaxation to equilibrium via strongly-damped LLG (alpha = 1) ---
# Robust: precession helps the state settle into the true minimum. A pure gradient
# (no-precession) descent can stick in a near-uniform metastable state, so we run
# the actual damped dynamics. `dt` is a real time step, `n` the number of steps.
relax(m0, heff, dt, n) = iterate(m -> step(m, heff, 1.0, dt), m0, n)

# --- adaptive Dormand-Prince RK45 (mumax's default solver) ---
# One DP45 step from m over time h; returns (5th-order solution, embedded error).
private dp45(m, heff, a, h) = {
    k1 = llg(m, heff(m), a);
    z2 = m + h*(1/5*k1);                                            q2 = llg(z2, heff(z2), a);
    z3 = m + h*(3/40*k1 + 9/40*q2);                                 q3 = llg(z3, heff(z3), a);
    z4 = m + h*(44/45*k1 - 56/15*q2 + 32/9*q3);                     q4 = llg(z4, heff(z4), a);
    z5 = m + h*(19372/6561*k1 - 25360/2187*q2 + 64448/6561*q3 - 212/729*q4);   q5 = llg(z5, heff(z5), a);
    z6 = m + h*(9017/3168*k1 - 355/33*q2 + 46732/5247*q3 + 49/176*q4 - 5103/18656*q5); q6 = llg(z6, heff(z6), a);
    y5 = m + h*(35/384*k1 + 500/1113*q3 + 125/192*q4 - 2187/6784*q5 + 11/84*q6);
    q7 = llg(y5, heff(y5), a);
    y4 = m + h*(5179/57600*k1 + 7571/16695*q3 + 393/640*q4 - 92097/339200*q5 + 187/2100*q6 + 1/40*q7);
    (y5, max(abs(y5 - y4)))
}
# One adaptive step of state (m, t, dt): step to at most t_end, accept if the error
# is within tol (then grow dt), otherwise reject and retry with a smaller dt.
private adaptiveStep(s, heff, a, t_end, tol) = {
    m = s[0]; t = s[1]; dt = s[2];
    if(t >= t_end, s, {
        h   = min(dt, t_end - t);
        res = dp45(m, heff, a, h);
        err = res[1] / tol;
        fac = 0.9 * (1 / max(err, 1e-12))^0.2;
        if(err <= 1,
           (vec.normalize(res[0]), t + h, dt * vec.clamp(fac, 0.2, 5)),
           (m, t, dt * vec.clamp(fac, 0.2, 0.9)))
    })
}
# Integrate adaptively from m0 to t_end with error-per-step `tol` (like mumax
# MaxErr). `dt0` is the initial step, `maxsteps` an upper bound on iterations.
adaptive(m0, heff, a, dt0, t_end, tol, maxsteps) =
    iterate(s -> adaptiveStep(s, heff, a, t_end, tol), (m0, 0.0, dt0), maxsteps)[0]
